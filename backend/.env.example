# BugFlow Backend Environment Variables Example
# Duplicate this file to .env for local overrides

ENVIRONMENT=production
SEED_DEMO_DATA=true
DATABASE_URL=postgresql+psycopg://bugflow_user:password@localhost:5432/bugflow
JWT_SECRET=your-secret-key-change-in-production
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
CORS_ORIGINS=https://bugflow-nine.vercel.app,http://localhost:3000,http://localhost:5173
