# Database connection string
# Development: sqlite:///./bugflow.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite:///./bugflow.db

# JWT signing key
JWT_SECRET_KEY=bugflow_super_secret_jwt_key_2026_antigravity

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment mode: development | production
ENVIRONMENT=development

# Seed demo data if database tables are empty: true | false
SEED_DEMO_DATA=true

# Optional: Google Gemini API Key
GEMINI_API_KEY=
