# ==========================================
# BugFlow Global Production Environment Configuration
# ==========================================

# ------------------------------------------
# Backend Environment Variables (Render / FastAPI)
# ------------------------------------------
# Database connection string.
# Development: sqlite:///./bugflow.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite:///./bugflow.db

# JWT secret key for signing authentication tokens. Change to a strong random string in production.
JWT_SECRET_KEY=bugflow_super_secret_jwt_key_2026_antigravity

# Allowed origins for CORS (comma-separated list).
# Development: http://localhost:5173,http://localhost:3000
# Production: https://YOUR-BUGFLOW-APP.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application execution environment: development | production
ENVIRONMENT=development

# Enable or disable initial demo data seeding on startup: true | false
SEED_DEMO_DATA=true

# Optional: Google Gemini API Key for AI features (Defect intelligence, copilot Q&A)
GEMINI_API_KEY=

# ------------------------------------------
# Frontend Environment Variables (Vercel / Vite)
# ------------------------------------------
# Target Backend API URL for React frontend.
# Development: http://localhost:8000 (or /api for local proxy)
# Production: https://YOUR-RENDER-BACKEND.onrender.com
VITE_API_URL=http://localhost:8000
